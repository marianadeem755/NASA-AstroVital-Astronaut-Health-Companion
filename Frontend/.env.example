# Backend FastAPI base URL (default backend prefix is /api/v1)
# Leave this as /api/v1 : Vite forwards it to the backend (port 8000), so there is no CORS error.
VITE_API_BASE_URL=/api/v1

# Keep true until the backend contains demo astronaut records and live APIs are ready.
VITE_USE_MOCKS=true
VITE_DEFAULT_ASTRONAUT_ID=1
